{
  "name": "codeshot.dev",
  "version": "0.1.0",
  "description": "Turn source code into polished PNG screenshots with codeshot.dev",
  "homepage": "https://codeshot.dev",
  "bugs": {
    "url": "https://github.com/infomiho/code-screenshot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infomiho/code-screenshot.git",
    "directory": "cli"
  },
  "bin": {
    "codeshot": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ky": "^2.0.2",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
